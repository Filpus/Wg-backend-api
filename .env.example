# Skopiuj ten plik do .env i uzupelnij prawdziwymi wartosciami.
# NIE commituj pliku .env (jest w .gitignore).

# Haslo do bazy Postgres uzywanej przez docker-compose.
POSTGRES_PASSWORD=

# Klucz podpisujacy tokeny JWT (HS256).
# Wymagane min. 32 bajty (256 bitow). Wygeneruj np.:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
JWT_KEY=

# Adres frontendu (CORS/redirects po stronie backendu).
FRONTEND_URL=

# Dane logowania Google OAuth (opcjonalne, jesli logowanie przez Google jest wlaczone).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
